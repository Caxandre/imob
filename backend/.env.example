NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Control Plane database (global SaaS data: tenants, plans, billing, provisioning).
# Never used to store tenant business data.
CONTROL_PLANE_DATABASE_URL=postgres://postgres:postgres@localhost:5434/imob_control

# Redis instance for BullMQ and other future caching/queueing needs.
REDIS_URL=redis://localhost:6379

# ACTIVE database_clusters.name the provisioning cluster selector targets locally
# (see ADR-003). Locally this should point at the `postgres-tenants` Docker Compose service
# (host "localhost", port 5433). `pnpm dev:full` bootstraps a matching database_clusters row
# and its admin credential automatically on startup (see DEV_BOOTSTRAP_CLUSTER_* below) — but
# `pnpm dev` / `pnpm dev:provisioning-worker` / `pnpm dev:dispatcher`, run as separate
# processes, still require the row (and, for the worker, the admin secret in its own
# SecretStore) to be seeded manually before anything can be provisioned.
TENANT_DATABASE_DEFAULT_CLUSTER=local-tenants

# DEV-ONLY, read exclusively by `pnpm dev:full` (src/main/dev-full.ts) — never by `pnpm dev`,
# the provisioning worker, or the dispatcher. Idempotently bootstraps the
# TENANT_DATABASE_DEFAULT_CLUSTER row above (host/port here) and seeds its admin credential
# into dev-full's in-memory SecretStore on every startup. Defaults already match
# docker-compose.yml's postgres-tenants service — only override if you changed that.
# DEV_BOOTSTRAP_CLUSTER_HOST=localhost
# DEV_BOOTSTRAP_CLUSTER_PORT=5433
# DEV_BOOTSTRAP_CLUSTER_ADMIN_USERNAME=postgres
# DEV_BOOTSTRAP_CLUSTER_ADMIN_PASSWORD=postgres

# Provisioning dispatcher (see src/workers/provisioning-dispatcher.ts). All optional —
# defaults shown below.
# PROVISIONING_DISPATCH_BATCH_SIZE=10
# PROVISIONING_DISPATCH_LEASE_SECONDS=30
# PROVISIONING_DISPATCH_POLL_INTERVAL_MS=5000

# Provisioning execution lease/heartbeat/recovery (see src/workers/provisioning-worker.ts).
# Independent of the dispatch lease above — never share state (ADR-003). All optional —
# defaults shown below. The heartbeat interval must stay well below the lease duration.
# PROVISIONING_EXECUTION_LEASE_SECONDS=60
# PROVISIONING_EXECUTION_HEARTBEAT_INTERVAL_MS=20000
# PROVISIONING_RECOVERY_POLL_INTERVAL_MS=30000
# PROVISIONING_RECOVERY_BATCH_SIZE=10

# Media outbox dispatcher (Prompt 031, ADR-009 — see src/workers/media-outbox-dispatcher.ts).
# All optional — defaults shown below.
# MEDIA_OUTBOX_DISPATCH_TENANT_BATCH_SIZE=25
# MEDIA_OUTBOX_DISPATCH_EVENT_BATCH_SIZE=20
# MEDIA_OUTBOX_DISPATCH_POLL_INTERVAL_MS=5000
# MEDIA_OUTBOX_DISPATCH_CONCURRENCY=5
# MEDIA_OUTBOX_DISPATCH_LEASE_SECONDS=30

# Cloudflare R2 object storage (ADR-006). All optional here — no entrypoint requires these to
# start; they are validated as a complete set only when the R2 adapter is actually constructed
# (createCloudflareR2ObjectStorage — no consumer wires this in yet, see ARCHITECTURE.md). The
# bucket referenced by R2_BUCKET must already exist — it is never created automatically.
# NEVER put real values here or commit this file with values filled in.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Set to "true" to run the real (non-mocked) Cloudflare R2 integration test — only takes effect
# when every R2_* var above is also set; otherwise that test is always skipped, including in
# CI. See src/infrastructure/object-storage/cloudflare-r2-object-storage.integration.test.ts.
# RUN_R2_INTEGRATION_TESTS=true
