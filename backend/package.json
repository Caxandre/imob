{
  "name": "imob-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main/server.ts",
    "dev:dispatcher": "tsx watch --env-file=.env src/workers/provisioning-dispatcher.ts",
    "dev:provisioning-worker": "tsx watch --env-file=.env src/workers/provisioning-worker.ts",
    "dev:media-dispatcher": "tsx watch --env-file=.env src/workers/media-outbox-dispatcher.ts",
    "dev:full": "tsx watch --env-file=.env src/main/dev-full.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/main/server.js",
    "start:dispatcher": "node --env-file=.env dist/workers/provisioning-dispatcher.js",
    "start:provisioning-worker": "node --env-file=.env dist/workers/provisioning-worker.js",
    "start:media-dispatcher": "node --env-file=.env dist/workers/media-outbox-dispatcher.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/infrastructure/database/control-plane/migrate.ts",
    "tenant-db:generate": "drizzle-kit generate --config=drizzle.tenant.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "bullmq": "^6.2.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
