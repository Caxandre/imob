# Base URL of the backend API (backend/README.md). Read exclusively by src/lib/env.ts —
# never import.meta.env directly elsewhere (see frontend/CLAUDE.md).
VITE_API_URL=http://localhost:3000

# Temporary Tenant Data Plane identifier (backend/src/app/tenant-context.ts) — sent as the
# X-Tenant-Id header, but only by features that explicitly need it (e.g. Properties), never
# globally by apiFetch(). Optional: the app boots fine without it (e.g. to render the Home
# page); a page that requires it shows a dedicated "tenant not configured" state instead of
# making a request. Must be a UUID matching a tenant provisioned in your local backend.
VITE_TENANT_ID=
